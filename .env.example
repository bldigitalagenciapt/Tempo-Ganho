# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - TEMPO & GANHO SAAS
# Duplique este ficheiro como '.env' e preencha com as suas chaves reais
# ==============================================================================

# Supabase (Obtenha em: Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Stripe (Obtenha em: Stripe Dashboard > Developers > API keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_STRIPE_PRICE_MONTHLY_ID=price_...
VITE_STRIPE_PRICE_YEARLY_ID=price_...

# URL base da sua aplicação (local ou Vercel)
VITE_APP_URL=http://localhost:3000
