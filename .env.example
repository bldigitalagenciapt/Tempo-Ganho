# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - TEMPO & GANHO SAAS
# Duplique este ficheiro como '.env' na raiz do projeto e preencha as suas chaves
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Banco de Dados & Autenticação)
# Obtenha em: https://supabase.com/dashboard > Seu Projeto > Project Settings > API
# ------------------------------------------------------------------------------
# Project URL (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Project API Anon Key (chave pública segura para o frontend)
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Service Role Secret (OPCIONAL, mas recomendado para Webhooks do Stripe no backend)
# ATENÇÃO: NUNCA exponha esta chave no frontend (não use prefixo VITE_)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-aqui

# ------------------------------------------------------------------------------
# 2. STRIPE (Pagamentos & Assinaturas)
# Obtenha em: https://dashboard.stripe.com/test/apikeys
# ------------------------------------------------------------------------------
# Chave pública do Stripe (usada no frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Chave secreta do Stripe (usada apenas nas rotas serverless /api da Vercel)
STRIPE_SECRET_KEY=sk_test_...

# Segredo de Assinatura do Webhook (Dashboard Stripe > Developers > Webhooks)
# Necessário apenas se configurar webhook na Vercel (https://seu-app.vercel.app/api/stripe-webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# IDs dos Preços dos Produtos criados no Stripe (Stripe > Product Catalog > Preços)
VITE_STRIPE_PRICE_MONTHLY_ID=price_...
VITE_STRIPE_PRICE_YEARLY_ID=price_...

# (Opcional - Alternativa aos Preços acima) Links diretos de pagamento (Stripe Payment Links)
VITE_STRIPE_PAYMENT_LINK_MONTHLY=
VITE_STRIPE_PAYMENT_LINK_YEARLY=

# ------------------------------------------------------------------------------
# 3. VERCEL & APLICAÇÃO
# ------------------------------------------------------------------------------
# URL pública onde a aplicação roda (local ou o seu domínio da Vercel)
VITE_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. ASSISTENTE IA (Google Gemini - Opcional)
# Obtenha em: https://aistudio.google.com/
# ------------------------------------------------------------------------------
VITE_GEMINI_API_KEY=
